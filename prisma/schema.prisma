generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                  String               @id @default(cuid())
  slug                String               @unique // E.g., "gastroshows"
  name                String
  domain              String?              @unique // E.g., "gastroshows.es" (custom domain support)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
   
  // Relations
  users               User[]
  contacts            Contact[]
  settings            Setting[]
  auditLogs           AuditLog[]
  apiTransferGrants   ApiTransferGrant[]
  apiTransferLogs     ApiTransferLog[]
  passwordResetTokens PasswordResetToken[]
  artworks            Artwork[]
  consignments        Consignment[]
  shops               Shop[]
  coreProducts        CoreProduct[]
  stockMovements      StockMovement[]
  eduStudents         EduStudent[]
  eduSkills           EduSkill[]
  eduExercises        EduExercise[]
  eduSongs            EduSong[]
  eduLessons          EduLesson[]
  eduCourseGoals      EduCourseGoal[]
  eduTerms            EduTerm[]
  eduSharedResources  EduSharedResource[]
  eduOutboxMessages   EduOutboxMessage[]
  eduArtistProfiles   EduArtistProfile[]
  eduSongProjects     EduSongProject[]
  eduReleases         EduRelease[]
  eduStreamStats      EduStreamStat[]
  eduTrash            EduTrash[]
  eduRooms            EduRoom[]
  eduCalendarLinks    EduCalendarLink[]
  eduTeacherProfiles  EduTeacherProfile[]
  backupLogs          BackupLog[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  eduLessonsAsTeacher EduLesson[]
  eduTeacherProfile EduTeacherProfile?

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token     String    @unique @default(uuid())
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([tenantId, email])
}

model Contact {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  phoneNormalized String?    // E164 sin +, ej. 34622334455 (solo dígitos, 9-15)
  email          String?
  contactType    ContactType @default(INDIVIDUAL)
  companyName    String?
  cif            String?     // NIF / CIF / DNI
  billingStreet  String?
  billingZip     String?
  billingCity    String?
  billingState   String?
  billingCountry String?
  notes          String?
  birthDate      DateTime?
  preferredChannel String?  @default("WHATSAPP")
  commsOptOut    Boolean    @default(false)

  // ==========================================
  // MODOS RELATIONS & DYNAMIC FIELDS
  // ==========================================
  // Modo Creativo
  isCollector    Boolean     @default(false)
  collectorPrefs String?     // Preferencias estéticas de obras
  artworksBought Artwork[]   @relation(name: "ArtworksBought")
  consignments   Consignment[]

  // Modo Restaurante & Hotel
  allergies      String[]    // Alergias del comensal / comensales
  favoriteTable  String?
  passportNumber String?
  loyaltyPoints  Int         @default(0)

  orders         Order[]
  eduStudentAsContact EduStudent[] @relation("EduStudentContact")
  eduStudentAsTutor   EduStudent[] @relation("EduStudentTutor")

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([tenantId])
  @@index([email])
  @@index([tenantId, email])
  @@index([phoneNormalized])
  @@index([tenantId, phoneNormalized])
  @@index([createdAt])
  @@index([contactType])
}

model Artwork {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  creationYear     Int
  medium           String         // Ej: "Óleo sobre lienzo", "Escultura en bronce"
  height           Float          // en cm
  width            Float          // en cm
  depth            Float?         // en cm (opcional para 3D)
  weight           Float?         // en kg
  status           ArtworkStatus  @default(AVAILABLE)
  location         String         // Ubicación física actual (ej. "Estudio Principal")
  price            Decimal        @db.Decimal(10, 2)
  currency         String         @default("EUR")
  images           String[]       // URLs de imágenes en Cloudflare R2
  notes            String?
  signatureStatus  String?        // Ej: "Firmado en el reverso", "Sin firmar"
  
  // Relaciones con el Core CRM
  collectorId      String?        // Coleccionista que posee la obra (si está vendida)
  collector        Contact?       @relation(name: "ArtworksBought", fields: [collectorId], references: [id])
  
  // Relaciones con Módulos de Arte
  consignments     ConsignmentLine[]
  certificate      Certificate?
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([collectorId])
}

model Consignment {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  galleryId        String            // El contacto en el Core que actúa como Galería (Company)
  gallery          Contact           @relation(fields: [galleryId], references: [id])
  startDate        DateTime          @default(now())
  endDate          DateTime?         // Fecha límite de exposición/devolución
  commissionRate   Float             @default(50.0) // Porcentaje que se queda la galería
  status           ConsignmentStatus @default(ACTIVE)
  notes            String?
  lines            ConsignmentLine[]
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId])
  @@index([galleryId])
  @@index([status])
}

model ConsignmentLine {
  id            String      @id @default(cuid())
  consignmentId String
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  artworkId     String
  artwork       Artwork     @relation(fields: [artworkId], references: [id])
  returnedAt    DateTime?   // Si la obra fue devuelta al estudio sin venderse
  soldAt        DateTime?   // Si la obra fue vendida durante la consignación
  salePrice     Decimal?    @db.Decimal(10, 2)

  @@unique([consignmentId, artworkId])
}

model Certificate {
  id               String    @id @default(cuid())
  artworkId        String    @unique
  artwork          Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  verificationCode String    @unique // Hash/UUID para la URL pública del QR
  issuedAt         DateTime  @default(now())
  pdfUrl           String    // URL del PDF firmado en R2
  
  @@index([verificationCode])
}

model Setting {
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@id([tenantId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  table     String
  recordId  String
  details   String?
  ipAddress String?
  userAgent String?
  success   Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([table, createdAt])
}

model ApiTransferGrant {
  id          String                @id @default(cuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  direction   DataTransferDirection
  peerSlug    String
  peerDomain  String?
  resource    String
  isEnabled   Boolean               @default(false)
  expiresAt   DateTime?
  createdBy   String?
  notes       String?
  lastUsedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([tenantId, direction, peerSlug, resource])
  @@index([tenantId, isEnabled])
  @@index([peerSlug, resource])
}

model ApiTransferLog {
  id          String                @id @default(cuid())
  tenantId    String
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grantId     String?
  direction   DataTransferDirection
  peerSlug    String
  resource    String
  operation   String
  recordCount Int                   @default(0)
  success     Boolean               @default(true)
  error       String?
  createdAt   DateTime              @default(now())

  @@index([tenantId, createdAt])
  @@index([grantId])
  @@index([peerSlug, resource])
}

enum UserRole {
  ADMIN
  STAFF
  DEV
  PROFESSOR
}

enum ContactType {
  INDIVIDUAL
  COMPANY
}

enum ArtworkStatus {
  AVAILABLE
  CONSIGNED
  RESERVED
  SOLD
  LOANED
  DESTROYED
}

enum ConsignmentStatus {
  ACTIVE
  CLOSED
  OVERDUE
}

enum ModeType {
  RESTAURANTE
  HOTEL
  LOGISTICA
  FINANZAS
  CREATIVO
  TECNOLOGICO
  DIRECCION
  GESTION_EQUIPO
  VENTAS
  ATENCION_CLIENTE
  COMUNICACION
  GESTION_PROYECTOS
}

enum DataTransferDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

// ==========================================
// CORE PRODUCT CATALOG & BOM (ODOO 19 STYLE)
// ==========================================

model CoreProduct {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                String?         // SKU / Código de barras
  name                String
  description         String?
  productType         ProductType     @default(STORABLE)
  price               Decimal         @default(0.00) @db.Decimal(10, 2)
  cost                Decimal         @default(0.00) @db.Decimal(10, 2)
  uom                 String          @default("ud") // Unidad de medida (kg, g, l, ml, ud)
  isSellable          Boolean         @default(true)
  isPurchasable       Boolean         @default(true)
  isComponent         Boolean         @default(false)
  image               String?
  stockQty            Decimal         @default(0.00) @db.Decimal(10, 3) // Stock físico para ingredientes (ej. kg harina)
  lowStockThreshold   Decimal?        @db.Decimal(10, 3)

  // Relaciones BOM (Ingredientes / Receta)
  bomLinesAsParent     BomLine[] @relation("ParentProduct")
  bomLinesAsIngredient BomLine[] @relation("IngredientProduct")

  // Relación con E-Commerce
  shopProducts         Product[]
  stockMovements      StockMovement[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId])
  @@index([tenantId, productType])
  @@index([tenantId, isSellable])
  @@index([tenantId, isComponent])
}

model StockMovement {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coreProductId String
  coreProduct   CoreProduct @relation(fields: [coreProductId], references: [id], onDelete: Cascade)
  type          StockMovementType
  qty           Decimal  @db.Decimal(10, 3)
  uom           String   @default("kg")
  reason        String?  // "ORDER #1234", "MANUAL_ADJUST", "WASTE"
  orderId       String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([coreProductId, createdAt])
  @@index([orderId])
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

model BomLine {
  id           String      @id @default(cuid())
  parentId     String
  parent       CoreProduct @relation("ParentProduct", fields: [parentId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   CoreProduct @relation("IngredientProduct", fields: [ingredientId], references: [id])
  quantity     Float
  uom          String      @default("kg")
  notes        String?

  createdAt    DateTime    @default(now())

  @@index([parentId])
  @@index([ingredientId])
}

enum ProductType {
  STORABLE
  CONSUMABLE
  SERVICE
  MANUFACTURED_KIT
}

// ==========================================
// E-COMMERCE & WEB BUILDER MODELS
// ==========================================

model Shop {
  id                   String            @id @default(cuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug                 String            @unique
  name                 String
  description          String?
  logo                 String?
  coverImage           String?
  mode                 ShopMode          @default(MINIMAL)
  templateId           String            @default("obrador-tradicional")
  theme                Json?
  sections             Json?             // Sitebuilder bloques [{id,type,props,isVisible,sortOrder}]
  customHtml           String?           @db.Text
  customCss            String?           @db.Text
  customDomain         String?           @unique
  domainStatus         DomainStatus      @default(PENDING)
  domainVerifyToken    String?
  isActive             Boolean           @default(true)
  businessContext      String?           @db.Text
  paymentProvider      String?           @default("CASH") // "CASH" | "REDSYS"
  redsysMerchantCode   String?
  redsysTerminal       String?           @default("1")
  redsysSecretKey      String?
  redsysEnv            String?           @default("test") // "test" | "live"

  products             Product[]
  pickupPoints         PickupPoint[]
  orders               Order[]
  aiSessions           ShopAISession[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  @@index([tenantId])
  @@index([customDomain])
}

model Product {
  id            String       @id @default(cuid())
  shopId        String
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  coreProductId String?
  coreProduct   CoreProduct? @relation(fields: [coreProductId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  price         Decimal      @db.Decimal(8, 2)
  image         String?
  maxDaily      Int          @default(50)
  currentStock  Int          @default(50)
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)

  orderLines    OrderLine[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([shopId])
  @@index([shopId, isActive])
  @@index([coreProductId])
}

model PickupPoint {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  schedule  String?  // legacy libre, mantener compat
  isActive  Boolean  @default(true)

  orders    Order[]
  windows   PickupWindow[]

  createdAt DateTime @default(now())

  @@index([shopId])
}

model PickupWindow {
  id            String   @id @default(cuid())
  pickupPointId String
  pickupPoint   PickupPoint @relation(fields: [pickupPointId], references: [id], onDelete: Cascade)
  label         String   // ej. "Mañana 08:00-13:00"
  start         String   // "08:00"
  end           String   // "13:00"
  capacity      Int      @default(30)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  orders        Order[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pickupPointId])
  @@index([pickupPointId, isActive])
}

model Order {
  id                  String       @id @default(cuid())
  shopId              String
  shop                Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  pickupPointId       String?
  pickupPoint         PickupPoint? @relation(fields: [pickupPointId], references: [id])
  pickupWindowId      String?
  pickupWindow        PickupWindow? @relation(fields: [pickupWindowId], references: [id])
  pickupDate          DateTime?    // día de recogida elegido por cliente
  pickupCode          String?      @unique // 4 dígitos numéricos para verificación
  verifiedAt          DateTime?
  verifiedById        String?
  customerName        String
  customerPhone       String?
  customerPhoneNormalized String?
  contactId           String?
  contact             Contact?     @relation(fields: [contactId], references: [id])
  status              OrderStatus  @default(PENDING)
  notes               String?
  totalAmount         Decimal      @db.Decimal(10, 2)
  paymentProvider     String?      // "CASH" | "REDSYS"
  paymentStatus       String?      // "PENDING" | "PAID" | "FAILED"
  paymentId           String?

  lines               OrderLine[]

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([pickupCode])
  @@index([pickupWindowId])
  @@index([contactId])
  @@index([customerPhoneNormalized])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(8, 2)

  @@index([orderId])
}

model ShopAISession {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages  Json
  snapshot  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

enum ShopMode {
  MINIMAL
  CUSTOM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  DELIVERED
  CANCELLED
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

// ==========================================
// EDUCACIÓN — MODO MULTI-INSTRUMENTO + ARTISTA
// ==========================================

enum EduLevel {
  INICIACION
  BASICO
  INTERMEDIO
  AVANZADO
}

enum EduTier {
  ALUMNO
  ARTISTA
}

enum EduCommsMode {
  TUTOR_ONLY
  STUDENT_ONLY
  BOTH
}

enum EduBillingMode {
  TUTOR
  PROPIO
}

enum EduGoalScope {
  COURSE
  TRIMESTER_1
  TRIMESTER_2
  TRIMESTER_3
}

enum EduGoalStatus {
  PENDING
  IN_PROGRESS
  ACHIEVED
  POSTPONED
}

enum EduExerciseType {
  TECHNIQUE
  CHORD
  RHYTHM
  THEORY
  WARMUP
  HOMEWORK
}

enum EduLessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SongStatus {
  IDEA
  WRITING
  DEMO
  PRODUCING
  MIX
  MASTER
  READY
  PUBLISHED
  ARCHIVED
}

enum AudioStage {
  DEMO
  PRODUCING
  MIX
  MASTER
  STEMS
}

enum ReleaseStatus {
  DRAFT
  SUBMITTED
  LIVE
  TAKEDOWN
}

model EduStudent {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId            String   @unique
  contact              Contact  @relation("EduStudentContact", fields: [contactId], references: [id], onDelete: Restrict)
  tutorContactId       String?
  tutorContact         Contact? @relation("EduStudentTutor", fields: [tutorContactId], references: [id], onDelete: SetNull)
  instruments          String[] // ["GUITARRA","VOZ"]
  primaryInstrument    String?
  levelByInstrument    Json?    // { GUITARRA: "BASICO", PIANO: "INICIACION" }
  musicalTastes        String[] // ["rock","flamenco"]
  favArtists           String[]
  favSongs             String[]
  availablePracticeMinPerDay Int?
  tier                 EduTier  @default(ALUMNO)
  commsMode            EduCommsMode @default(TUTOR_ONLY)
  guardianRelation     String?
  billingMode          EduBillingMode @default(TUTOR)
  isArtist             Boolean  @default(false)
  portalToken          String   @unique @default(uuid())
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?
  lessons              EduLesson[]
  courseGoals          EduCourseGoal[]
  sharedResources      EduSharedResource[]
  outboxMessages       EduOutboxMessage[]
  artistProfile        EduArtistProfile?
  songProjects         EduSongProject[]
  skillAssessments     EduSkillAssessment[]

  @@index([tenantId])
  @@index([contactId])
  @@index([tutorContactId])
  @@index([tenantId, isActive])
  @@index([tenantId, isArtist])
}

model EduSkill {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instrument String  // GUITARRA | BAJO | PIANO | BATERIA | VOZ | COMMON
  key       String
  label     String
  category  String   // tecnica | ritmo | teoria | repertorio
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  assessments EduSkillAssessment[]

  @@unique([tenantId, instrument, key])
  @@index([tenantId, instrument])
}

model EduSkillAssessment {
  id         String   @id @default(cuid())
  tenantId   String
  studentId  String
  student    EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId    String
  skill      EduSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  rating     Int      // 1-5
  comment    String?
  assessedBy String?
  lessonId   String?
  lesson     EduLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assessedAt DateTime @default(now())

  @@index([tenantId, studentId])
  @@index([studentId, skillId, assessedAt])
  @@index([skillId])
}

model EduCourseGoal {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String
  student     EduStudent   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instrument  String?
  scope       EduGoalScope
  title       String
  description String?      @db.Text
  targetDate  DateTime?
  status      EduGoalStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId, studentId])
  @@index([studentId, scope])
}

model EduTerm {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseYear String  // "2025-2026"
  label     String   // "Trimestre 1"
  scope     EduGoalScope
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, courseYear, scope])
  @@index([tenantId, courseYear])
}

model EduExercise {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  type        EduExerciseType @default(TECHNIQUE)
  instrument  String          // GUITARRA | COMMON etc
  level       EduLevel        @default(BASICO)
  difficulty  Int             @default(3) // 1-5
  estimatedMin Int            @default(10)
  skillKeys   String[]
  description String?         @db.Text
  tabContent  String?         @db.Text
  tabUrl      String?
  mediaUrls   String[]
  sourceUrl   String?
  sourceType  String?         // VIDEO | BLOG | TAB | IMAGE
  isCurated   Boolean         @default(true)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sharedResources EduSharedResource[]

  @@index([tenantId])
  @@index([tenantId, instrument, level])
  @@index([tenantId, difficulty])
}

model EduSong {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  artist      String
  genre       String?
  level       EduLevel @default(BASICO)
  instrument  String?
  instruments String[] // multi
  key         String?
  capo        Int?
  skillKeys   String[]
  externalUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sharedResources EduSharedResource[]

  @@index([tenantId])
  @@index([tenantId, instrument])
}

model EduRoom {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   // "Aula 1", "Sala B", "Estudio"
  color     String?  // hex
  capacity  Int?     @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   EduLesson[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model EduCalendarLink {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId             String?  // User.id profesor dueño
  googleCalendarId   String?  // "primary" o id calendario
  googleAccessToken  String?  @db.Text
  googleRefreshToken String?  @db.Text
  syncEnabled        Boolean  @default(false)
  lastSyncAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, userId])
  @@unique([tenantId, userId, googleCalendarId])
}

model EduLesson {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId           String
  student             EduStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instrument          String          // instrumento de esta clase
  date                DateTime        @default(now())
  durationMin         Int             @default(45)
  status              EduLessonStatus @default(SCHEDULED)
  taughtSkills        String[]
  notes               String?         @db.Text
  homeworkExerciseIds String[]
  songIds             String[]
  ratingFocus         Int?
  nextGoals           String?         @db.Text
  teacherId           String?
  teacher             User?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId              String?
  room                EduRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  googleEventId       String?
  googleCalendarId    String?
  googleSyncStatus    String?         // pending | synced | error
  googleSyncError     String?         @db.Text
  whatsappSentAt      DateTime?
  whatsappMessageId   String?
  batchToken          String?         // token agregador r/batch
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  assessments         EduSkillAssessment[]
  sharedResources     EduSharedResource[]

  @@index([tenantId, studentId])
  @@index([tenantId, date])
  @@index([studentId, date])
  @@index([tenantId, teacherId])
  @@index([tenantId, roomId])
  @@index([googleEventId])
}

model EduSharedResource {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token      String   @unique @default(uuid())
  lessonId   String?
  lesson     EduLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  studentId  String
  student    EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise   EduExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  songId     String?
  song       EduSong? @relation(fields: [songId], references: [id], onDelete: SetNull)
  batchToken String?  // agrupador
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId, studentId])
  @@index([batchToken])
  @@index([token])
}

model EduOutboxMessage {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String
  student     EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String?
  channel     String   @default("WHATSAPP_CLOUD")
  waMessageId String?
  recipientContactId String?
  recipientRole String?
  toPhone     String
  body        String   @db.Text
  link        String?
  batchToken  String?
  status      String   @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | FAILED
  error       String?  @db.Text
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId, studentId, createdAt])
  @@index([waMessageId])
  @@index([batchToken])
  @@index([recipientContactId])
}

model EduArtistProfile {
  studentId   String   @id
  student     EduStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stageName   String?
  bio         String?  @db.Text
  avatarUrl   String?
  socials     Json?    // {instagram,tiktok,youtube,spotifyArtistId}
  distributor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model EduSongProject {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artistId    String
  artist      EduStudent @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title       String
  genre       String?
  instrument  String?
  status      SongStatus @default(IDEA)
  bpm         Int?
  key         String?
  capo        Int?
  projectId   String?    // FK futuro GESTION_PROYECTOS
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  lyrics      EduLyric[]
  audios      EduAudioAsset[]
  releases    EduRelease[]
  streamStats EduStreamStat[]

  @@index([tenantId, artistId, status])
  @@index([tenantId, status])
}

model EduLyric {
  id            String   @id @default(cuid())
  songProjectId String
  songProject   EduSongProject @relation(fields: [songProjectId], references: [id], onDelete: Cascade)
  version       Int      @default(1)
  content       String   @db.Text
  coWriters     String[]
  language      String?  @default("es")
  isExplicit    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  versions      EduLyricVersion[]

  @@index([songProjectId, version])
}

model EduLyricVersion {
  id        String   @id @default(cuid())
  lyricId   String
  lyric     EduLyric @relation(fields: [lyricId], references: [id], onDelete: Cascade)
  version   Int
  content   String   @db.Text
  diff      Json?
  createdAt DateTime @default(now())

  @@index([lyricId, version])
}

model EduAudioAsset {
  id            String     @id @default(cuid())
  songProjectId String
  songProject   EduSongProject @relation(fields: [songProjectId], references: [id], onDelete: Cascade)
  stage         AudioStage @default(DEMO)
  fileUrl       String
  fileName      String?
  mimeType      String?
  durationSec   Int?
  waveform      Json?
  version       Int        @default(1)
  notes         String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  deletedBy     String?

  @@index([songProjectId, stage])
  @@index([songProjectId, deletedAt])
}

model EduRelease {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  songProjectId String
  songProject   EduSongProject @relation(fields: [songProjectId], references: [id], onDelete: Cascade)
  releaseDate   DateTime?
  distributor   String?
  upc           String?
  isrc          String?
  platforms     String[]
  coverUrl      String?
  status        ReleaseStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([songProjectId])
}

model EduStreamStat {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  songProjectId String
  songProject   EduSongProject @relation(fields: [songProjectId], references: [id], onDelete: Cascade)
  platform      String   // spotify | apple | youtube | tiktok
  date          DateTime @db.Date
  plays         Int      @default(0)
  listeners     Int?
  revenue       Decimal? @db.Decimal(10, 4)
  fetchedAt     DateTime @default(now())

  @@unique([songProjectId, platform, date])
  @@index([tenantId, platform, date])
}

model EduTrash {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String   // EduLyric | EduAudioAsset | EduSongProject
  entityId   String
  payload    Json
  deletedAt  DateTime @default(now())
  expiresAt  DateTime
  restoredAt DateTime?
  deletedBy  String?

  @@index([tenantId, entityType])
  @@index([expiresAt])
}

model EduExerciseSearchCache {
  id        String   @id @default(cuid())
  tenantId  String
  queryHash String
  query     Json
  results   Json
  createdAt DateTime @default(now())

  @@unique([tenantId, queryHash])
  @@index([createdAt])
}

model EduTeacherProfile {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruments String[] // instrumentos que imparte
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, isActive])
  @@index([tenantId])
}

// ==========================================
// TRIPLE BACKUP 3-2-1 — DESACOPLADO EXTERNOS
// ==========================================

enum BackupDestination {
  LOCAL
  CLIENT_STORAGE
  PALMERP_VAULT
}

enum BackupKind {
  LOGICAL_JSON
  PHYSICAL_DUMP
}

enum BackupStatus {
  SUCCESS
  PARTIAL
  FAILED
}

model BackupLog {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination BackupDestination
  kind        BackupKind
  fileKey     String            // ej. tenants/<id>/daily/2026-09-15.logical.json.gz.enc
  checksum    String            // SHA256 hex del .enc
  sizeBytes   Int
  encrypted   Boolean           @default(true)
  status      BackupStatus      @default(SUCCESS)
  error       String?           @db.Text
  createdAt   DateTime          @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, destination, createdAt])
  @@index([fileKey])
  @@index([status, createdAt])
}

