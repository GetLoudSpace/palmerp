# === VERCEL + SUPABASE (single-DB) — Variables obligatorias en Vercel Dashboard ===
# Copia este archivo a .env.local para desarrollo y configura las mismas vars en Vercel → Settings → Environment Variables
NEXTAUTH_URL="http://localhost:3000"
# En producción Vercel: NEXTAUTH_URL="https://tudominio.com" (sin subdominio tenant)
# Genera uno seguro: openssl rand -base64 32
NEXTAUTH_SECRET="palmera-secret-key-development-mode-123456789"

# SINGLE-DB (Vercel + Supabase): una única DATABASE_URL para todos los tenants.
# En Supabase, USA EL POOLER en modo transaction (port 6543) con ?pgbouncer=true para serverless.
# Ejemplo Supabase pooler: postgresql://postgres.<project_ref>:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/palmera?schema=public"
PALMERA_PLATFORM_URL="http://localhost:3000"
# En producción Vercel: PALMERA_PLATFORM_URL="https://tudominio.com"

# AI (opcional pero recomendado para /api/daily-scrum y /api/insights)
# AI_PROVIDER="openrouter"  # o "ollama"
# OPENROUTER_API_KEY="sk-or-v1-..."
# AI_MODEL="google/gemma-3-4b-it:free"
# OLLAMA_BASE_URL="http://localhost:11434"

# LEGACY (deshabilitado en arquitectura single-DB): PALMERA_PLATFORM_DATABASE_URL ya no se usa para crear DBs por tenant.
# Ver migracion-multitenant-erp.md — aislamiento ahora es tenant_id + RLS en la DB única.

# Alta automatizada de una instancia (single-DB: INSERT en tenants, no CREATE DATABASE)
PALMERA_INSTANCE_SLUG="gastroshows"
PALMERA_INSTANCE_NAME="Gastroshows S.L."
PALMERA_INSTANCE_DOMAIN="gastroshows.palmerp.es"
PALMERA_INSTANCE_ADMIN_NAME="Admin"
PALMERA_INSTANCE_ADMIN_EMAIL="admin@gastroshows.es"
PALMERA_INSTANCE_ADMIN_PASSWORD="change-me"
PALMERA_INSTANCE_TIMEZONE="Europe/Madrid"
PALMERA_INSTANCE_MODES="RESTAURANTE,GESTION_EQUIPO,DIRECCION"

# === VERCEL API — Registro automático de dominios en provisionamiento ===
# Permite que `npm run instance:provision` registre el dominio en Vercel automáticamente.
# Sin estas variables el script funciona igual pero muestra un aviso y el dominio
# debe añadirse manualmente en Vercel → Settings → Domains.
#
# VERCEL_TOKEN:      Token de API personal → vercel.com/account/tokens → "Create Token"
# VERCEL_PROJECT_ID: ID del proyecto → Vercel Dashboard → proyecto → Settings → General → Project ID
# VERCEL_TEAM_ID:    Solo si usas una cuenta de equipo (Team) en Vercel (opcional)
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
# VERCEL_TEAM_ID=""  # Descomenta si usas cuenta de equipo

# === TRIPLE BACKUP 3-2-1 (02:00) — Destinations A/B/C — Cloudflare R2 10GB Gratis ===
# A) LOCAL MiniPC siempre ON (destino A) — retención 7d
# B) STORAGE SEGURIDAD CLIENTE (destino B) — retención 30d, bucket propiedad del cliente (R2 10GB gratis)
# C) VAULT PALMERP CENTRAL (destino C) — retención 90d inmutable, Palmerp no puede descifrar sin clave cliente (R2 vault separado)
# ¿Por qué Cloudflare R2? src/lib/storage.ts + src/lib/backup/storage-provider.ts usan S3Client con https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2 da 10 GB gratis + 0 € egress (vs AWS S3 que cobra por descarga) — hosting_and_business_strategy.md:113
# 2-10 MB/noche × 90 días = 0.2-0.9 GB → gratis. Pasos: dash.cloudflare.com/sign-up → R2 Object Storage → Enable R2 → Create bucket → Manage R2 API Tokens → Create Token → copia Access Key/Secret + Account ID
#
# Clave SOLO del cliente (si se pierde, el .enc es irrecuperable — imprime QR en onboarding)
# Genera: openssl rand -base64 32 | tr -d '\n'  (32 bytes → base64 44 chars)
BACKUP_ENCRYPTION_KEY="change-me-32bytes-base64-44chars"
BACKUP_LOCAL_DIR="/data/backups/palmerp"
# Destino B — R2 del cliente (su cuenta Cloudflare, 10GB gratis) — https://dash.cloudflare.com → R2 → Create bucket cliente-backups → Manage R2 API Tokens
# CLIENT_BACKUP_S3_ENDPOINT="https://<ACCOUNT_ID_CLIENTE>.r2.cloudflarestorage.com"
# CLIENT_BACKUP_S3_BUCKET="cliente-backups"
# CLIENT_BACKUP_S3_ACCESS_KEY="..."
# CLIENT_BACKUP_S3_SECRET_KEY="..."
# CLIENT_BACKUP_S3_REGION="auto"
# Destino C — Vault central PalmerP (tu cuenta R2 separada, inmutable 90d) — mismo flujo pero en tu cuenta Account ID vault
# PALMERP_VAULT_R2_ACCOUNT_ID="..."
# PALMERP_VAULT_R2_ACCESS_KEY_ID="..."
# PALMERP_VAULT_R2_SECRET_ACCESS_KEY="..."
# PALMERP_VAULT_R2_BUCKET_NAME="palmerp-vault"
# Cron auth + Fleet heartbeat
# CRON_SECRET="..."  # Vercel Cron Authorization: Bearer ...
# FLEET_API_KEY="..." # Agente local → POST /api/fleet/backup-heartbeat Authorization: Bearer ...
# PALMERP_CONTROL_URL="https://control.palmerp.es" # opcional heartbeat central

# === FLEET UPDATES — igual que lo haces tú ===
# Cada cliente actualiza 1-click como tú: backup → fetch upstream → merge → migrate → build → push
# PALMERP_UPSTREAM_REPO="Palm-ERP/palmerp"  # repo base (tu palmerp)
# PALMERP_UPSTREAM_BRANCH="master"
# GITHUB_TOKEN="ghp_..."  # solo si el repo base es privado (para check API)

# === GOHIGHLEVEL — agenda/calendario + workflows (opcional, por tenant) ===
# La config vive en la tabla Setting (claves ghl_*), estas env son fallback global.
# 1. GHL → Settings → Private Integrations → crea token de sub-cuenta (scopes calendars/events.write, contacts.write)
# 2. Guarda en Setting: ghl_sync_enabled=true, ghl_api_token, ghl_location_id, ghl_calendar_id
# 3. Workflows: crea Inbound Webhook triggers y guarda sus URLs en
#    ghl_workflow_class_created_url / ghl_workflow_class_cancelled_url
# 4. Inbound (GHL→Palmera): apunta el webhook a /api/education/calendar/ghl-webhook?secret=...
#    con secret = Setting ghl_webhook_secret. ghl_inbound_apply=true solo si quieres
#    que GHL cambie estados de clase (default false: Palmera manda).
# GHL_API_TOKEN=""
# GHL_LOCATION_ID=""
# GHL_CALENDAR_ID=""
# GHL_WORKFLOW_CLASS_CREATED_URL=""
# GHL_WORKFLOW_CLASS_CANCELLED_URL=""
# GHL_WEBHOOK_SECRET=""

